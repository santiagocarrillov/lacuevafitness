// La Cueva — Dashboard Operativo + SRXFit
// Schema diseñado para cubrir Fases 1-3 sin migraciones disruptivas.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Organización
// ─────────────────────────────────────────────────────────────

enum Sede {
  FITNESS_CENTER
  XTREME
}

enum UserRole {
  OWNER
  ACCOUNTING
  ADMIN
  COACH
  NUTRITIONIST
  MEMBER
}

model User {
  id             String   @id @default(cuid())
  supabaseUserId String?  @unique
  email          String   @unique
  fullName       String
  phone          String?
  role           UserRole
  sede           Sede?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  member                  Member?
  coachClassSessions      ClassSession[]          @relation("CoachClassSessions")
  attendanceRecords       Attendance[]            @relation("AttendanceRecordedBy")
  coachConfirmations      CoachConfirmation[]
  leadsOwned              Lead[]                  @relation("LeadOwner")
  leadInteractions        LeadInteraction[]
  dailyIndicators         DailyIndicators[]
  evaluationsAsCoach      Evaluation[]            @relation("EvaluationCoach")
  memberNotes             MemberNote[]
  srxfitOverrides         SrxfitSessionOverride[] @relation("SrxfitSessionOverrideUpdatedBy")
  bodyCompsRecorded       BodyComposition[]       @relation("BodyCompositionRecordedBy")
  clinicalMarkersRecorded ClinicalMarker[]        @relation("ClinicalMarkerRecordedBy")
  clinicalRecordsAuthored ClinicalRecord[]        @relation("ClinicalRecordAuthor")
  mealPlansAuthored       MealPlan[]              @relation("MealPlanAuthor")

  @@index([sede, role])
}

// ─────────────────────────────────────────────────────────────
// Socios y membresías
// ─────────────────────────────────────────────────────────────

enum MemberStatus {
  LEAD
  TRIAL
  ACTIVE
  PAUSED
  CHURNED
}

model Member {
  id                        String       @id @default(cuid())
  userId                    String?      @unique
  user                      User?        @relation(fields: [userId], references: [id])
  // Portal access: one-time invite code an admin issues and sends (e.g. WhatsApp).
  // The socio redeems it once at /portal/signup to claim their account and set a
  // password. Nulled on redemption; expiresAt bounds the redemption window.
  portalInviteCode          String?      @unique
  portalInviteCodeExpiresAt DateTime?
  firstName                 String
  lastName                  String
  email                     String?      @unique
  phone                     String?
  dateOfBirth               DateTime?
  sex                       Sex?
  address                   String?
  occupation                String?
  emergencyName             String?
  emergencyPhone            String?
  preferredHour             String? // "morning", "evening", "afternoon" — derived from attendance
  sede                      Sede // primary/billing sede — drives reports & payments (unchanged)
  secondarySede             Sede? // optional 2nd sede the member also trains at (attendance only)
  status                    MemberStatus @default(LEAD)
  joinedAt                  DateTime     @default(now())
  churnedAt                 DateTime?
  churnReason               String?
  leadId                    String?      @unique
  lead                      Lead?        @relation(fields: [leadId], references: [id])
  stripeCustomerId          String?      @unique
  notes                     String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  memberships       Membership[]
  payments          Payment[]
  attendance        Attendance[]
  evaluations       Evaluation[]
  bodyCompositions  BodyComposition[]
  clinicalMarkers   ClinicalMarker[]
  testResults       TestResult[]
  trainingLevels    TrainingLevelAssignment[]
  goals             MemberGoal[]
  memberNotes       MemberNote[]
  clinicalRecords   ClinicalRecord[]
  mealPlans         MealPlan[]
  mealLogs          MealLog[]
  challengeProgress ChallengeProgress[]

  @@index([sede, status])
  @@index([lastName, firstName])
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  TRIAL
  ONE_TIME
}

model MembershipPlan {
  id            String       @id @default(cuid())
  sede          Sede?
  name          String
  description   String?
  priceCents    Int
  currency      String       @default("USD")
  billingCycle  BillingCycle
  durationDays  Int
  stripePriceId String?      @unique
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships Membership[]
}

enum MembershipState {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELED
  PAUSED
}

model Membership {
  id                   String          @id @default(cuid())
  memberId             String
  member               Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId               String
  plan                 MembershipPlan  @relation(fields: [planId], references: [id])
  state                MembershipState @default(PENDING_PAYMENT)
  customPriceCents     Int? // override plan price (discounts, special deals)
  paymentMethod        String? // "TC", "Transferencia", "Efectivo", etc.
  billingNote          String? // "Cobrado $50/mes con TC", "15% desc transferencia"
  startsAt             DateTime
  endsAt               DateTime
  canceledAt           DateTime?
  stripeSubscriptionId String?         @unique
  autoRenew            Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  payments Payment[]

  @@index([memberId, state])
  @@index([endsAt])
}

// ─────────────────────────────────────────────────────────────
// Pagos y conciliación
// ─────────────────────────────────────────────────────────────

enum PaymentMethod {
  STRIPE_CARD
  STRIPE_LINK
  BANK_TRANSFER
  CASH
  PLUX_CARD // Tarjeta de crédito vía TC Plux (procesador distinto de Stripe)
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                    String        @id @default(cuid())
  memberId              String? // null for Isabel's bank pool entries (isPoolEntry = true)
  member                Member?       @relation(fields: [memberId], references: [id])
  membershipId          String?
  membership            Membership?   @relation(fields: [membershipId], references: [id])
  amountCents           Int
  currency              String        @default("USD")
  method                PaymentMethod
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?
  // ── Detalle bancario ─────────────────────────────────────────────────
  depositorName         String? // Nombre del depositante / tarjetahabiente
  bankReference         String? // # referencia / transacción
  bankEntity            String? // Entidad bancaria (Pichincha, Stripe…)
  isPoolEntry           Boolean       @default(false) // true → entrada de banco sin asignar (Isabel)
  // ── Stripe / QBO (postergado) ────────────────────────────────────────
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?       @unique
  qboTransactionId      String?       @unique
  reconciledAt          DateTime?
  sede                  Sede
  recordedByUserId      String?
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([sede, paidAt])
  @@index([status])
  @@index([isPoolEntry, status])
}

// ─────────────────────────────────────────────────────────────
// Clases, horarios y asistencia
// ─────────────────────────────────────────────────────────────

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model ClassSchedule {
  id          String    @id @default(cuid())
  sede        Sede
  dayOfWeek   DayOfWeek
  startTime   String // "HH:MM"
  durationMin Int       @default(60)
  name        String
  capacity    Int       @default(30)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions ClassSession[]

  @@index([sede, dayOfWeek])
}

model ClassSession {
  id          String         @id @default(cuid())
  scheduleId  String?
  schedule    ClassSchedule? @relation(fields: [scheduleId], references: [id])
  sede        Sede
  date        DateTime       @db.Date
  startAt     DateTime
  coachId     String?
  coach       User?          @relation("CoachClassSessions", fields: [coachId], references: [id])
  adminCount  Int?
  coachCount  Int?
  discrepancy Boolean        @default(false)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  attendance        Attendance[]
  coachConfirmation CoachConfirmation?

  @@unique([scheduleId, date])
  @@index([sede, date])
}

model Attendance {
  id                     String       @id @default(cuid())
  memberId               String
  member                 Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  classSessionId         String
  classSession           ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  recordedByUserId       String?
  recordedBy             User?        @relation("AttendanceRecordedBy", fields: [recordedByUserId], references: [id])
  recordedAt             DateTime     @default(now())
  expiredMembershipAlert Boolean      @default(false)

  @@unique([memberId, classSessionId])
  @@index([classSessionId])
}

model CoachConfirmation {
  id             String       @id @default(cuid())
  classSessionId String       @unique
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  coachUserId    String
  coach          User         @relation(fields: [coachUserId], references: [id])
  count          Int
  confirmedAt    DateTime     @default(now())
  notes          String?
}

// ─────────────────────────────────────────────────────────────
// Leads y pipeline de ventas
// ─────────────────────────────────────────────────────────────

enum LeadSource {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  PHONE_CALL
  WEB_FORM
  WALK_IN
  REFERRAL
  TIKTOK
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  SCHEDULED_TRIAL
  TRIAL_ATTENDED
  TRIAL_NO_SHOW
  NEGOTIATING
  CONVERTED
  LOST
}

model Lead {
  id               String     @id @default(cuid())
  sede             Sede
  firstName        String
  lastName         String?
  email            String?
  phone            String?
  source           LeadSource
  stage            LeadStage  @default(NEW)
  ownerUserId      String?
  owner            User?      @relation("LeadOwner", fields: [ownerUserId], references: [id])
  trialScheduledAt DateTime?
  trialAttended    Boolean?
  lostReason       String?
  convertedAt      DateTime?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  interactions LeadInteraction[]
  member       Member?
  conversation Conversation?

  @@index([sede, stage])
  @@index([source])
}

model LeadInteraction {
  id         String     @id @default(cuid())
  leadId     String
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?      @relation(fields: [userId], references: [id])
  channel    LeadSource
  summary    String
  occurredAt DateTime   @default(now())

  @@index([leadId])
}

// ─────────────────────────────────────────────────────────────
// Indicadores diarios por sede
// ─────────────────────────────────────────────────────────────

model DailyIndicators {
  id                String   @id @default(cuid())
  sede              Sede
  date              DateTime @db.Date
  leadsNew          Int      @default(0)
  leadsScheduled    Int      @default(0)
  trialsAttended    Int      @default(0)
  trialsNoShow      Int      @default(0)
  signups           Int      @default(0)
  renewals          Int      @default(0)
  churns            Int      @default(0)
  revenueCents      Int      @default(0)
  cashCloseCents    Int      @default(0)
  totalAttendance   Int      @default(0)
  submittedByUserId String?
  submittedBy       User?    @relation(fields: [submittedByUserId], references: [id])
  submittedAt       DateTime @default(now())
  notes             String?

  @@unique([sede, date])
}

// ─────────────────────────────────────────────────────────────
// SRXFit — evaluación y progreso (Fase 2)
// ─────────────────────────────────────────────────────────────

enum TrainingLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

model TrainingLevelAssignment {
  id               String        @id @default(cuid())
  memberId         String
  member           Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  level            TrainingLevel
  assignedAt       DateTime      @default(now())
  assignedByUserId String?
  rationale        String?

  @@index([memberId])
}

enum EvaluationType {
  ONBOARDING
  CYCLE_9_WEEK
  AD_HOC
}

model Evaluation {
  id          String         @id @default(cuid())
  memberId    String
  member      Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  coachId     String?
  coach       User?          @relation("EvaluationCoach", fields: [coachId], references: [id])
  type        EvaluationType
  cycleNumber Int?
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  summary     String?

  testResults      TestResult[]
  bodyCompositions BodyComposition[]

  @@index([memberId, startedAt])
}

enum TestKey {
  BACK_SQUAT_3RM
  DEADLIFT_3RM
  BENCH_PRESS_3RM
  PUSH_PRESS_3RM
  DEAD_HANG_SECONDS
  PULL_UPS_MAX
  RING_ROW_ANGLE
  PLANK_SECONDS
  CHRISTINE_TIME_SECONDS
  COOPER_METERS
  CLEAN_JERK_1RM
  SNATCH_1RM
  ROW_500M_SPRINT_SECONDS
}

model TestResult {
  id               String      @id @default(cuid())
  memberId         String
  member           Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  evaluationId     String?
  evaluation       Evaluation? @relation(fields: [evaluationId], references: [id])
  test             TestKey
  valueNumeric     Float
  unit             String
  recordedAt       DateTime    @default(now())
  recordedByUserId String?
  notes            String?

  @@index([memberId, test, recordedAt])
}

model BodyComposition {
  id              String      @id @default(cuid())
  memberId        String
  member          Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  evaluationId    String?
  evaluation      Evaluation? @relation(fields: [evaluationId], references: [id])
  measuredAt      DateTime    @default(now())
  weightKg        Float?
  heightCm        Float?
  bodyFatPct      Float?
  muscleMassKg    Float? // legacy — superseded by muscleMassPct
  muscleMassPct   Float?
  waistCm         Float?
  hipCm           Float?
  chestCm         Float?
  armCm           Float?
  thighCm         Float?
  waterPct        Float? // legacy, no longer captured
  basalMetabolism Int?
  notes           String?
  recordedById    String?
  recordedBy      User?       @relation("BodyCompositionRecordedBy", fields: [recordedById], references: [id])

  @@index([memberId, measuredAt])
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum MenopausalStatus {
  PRE
  PERI
  POST
}

model ClinicalMarker {
  id               String            @id @default(cuid())
  memberId         String
  member           Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  measuredAt       DateTime          @default(now())
  glucoseFasting   Float? // mg/dL
  triglycerides    Float? // mg/dL
  hdlCholesterol   Float? // mg/dL
  hsCRP            Float? // mg/L
  testosteroneFree Float? // ng/dL
  estradiolE2      Float? // pg/mL
  cycleDay         Int?
  menopausalStatus MenopausalStatus?
  notes            String?
  recordedById     String?
  recordedBy       User?             @relation("ClinicalMarkerRecordedBy", fields: [recordedById], references: [id])

  @@index([memberId, measuredAt])
}

model MemberGoal {
  id         String    @id @default(cuid())
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  goal       String
  targetDate DateTime?
  achieved   Boolean   @default(false)
  achievedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([memberId])
}

// ─────────────────────────────────────────────────────────────
// Metas mensuales y gastos (para reportes)
// ─────────────────────────────────────────────────────────────

model MonthlyTarget {
  id                 String   @id @default(cuid())
  sede               Sede
  year               Int
  month              Int // 1-12
  revenueTargetCents Int      @default(0) // Meta Facturación
  salesTarget        Int      @default(0) // Meta de ventas (# inscripciones)
  visitorsTarget     Int      @default(0) // Meta visitantes (clases de prueba)
  leadsTarget        Int      @default(0) // Meta averiguadores
  attendanceTarget   Int      @default(0) // Meta asistencias totales
  workingDays        Int      @default(21) // Días hábiles del mes
  projectedICVPct    Float    @default(50) // ICV proyectado %
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([sede, year, month])
}

enum ExpenseCategory {
  PAYROLL // Sueldos
  RENT // Arriendo
  UTILITIES // Servicios (luz, agua, internet)
  EQUIPMENT // Equipamiento y mantenimiento
  MARKETING // Publicidad y marketing
  SUPPLIES // Insumos (limpieza, oficina)
  SOFTWARE // Software (Stripe fees, HubSpot, etc)
  TAXES // Impuestos
  PROFESSIONAL // Servicios profesionales
  OTHER
}

model Expense {
  id          String          @id @default(cuid())
  sede        Sede? // null = gasto compartido
  category    ExpenseCategory
  description String
  amountCents Int
  date        DateTime        @db.Date
  recurring   Boolean         @default(false) // Gasto fijo mensual
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([sede, date])
  @@index([category])
}

// ─────────────────────────────────────────────────────────────
// Notas de comunicación (timeline del socio)
// ─────────────────────────────────────────────────────────────

model MemberNote {
  id              String   @id @default(cuid())
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  authorId        String?
  author          User?    @relation(fields: [authorId], references: [id])
  content         String
  // Private by default. The portal only ever surfaces notes explicitly shared.
  visibleToMember Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([memberId, createdAt])
}

// Free-text clinical history / anamnesis. Staff-only by construction: no portal
// page, server component, or action ever queries this model. Privacy is structural,
// not flag-based — there is nothing to accidentally expose.
model ClinicalRecord {
  id           String   @id @default(cuid())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  content      String   @db.Text
  authoredById String?
  authoredBy   User?    @relation("ClinicalRecordAuthor", fields: [authoredById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([memberId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Retos y gamificación
// ─────────────────────────────────────────────────────────────

enum ChallengeRuleType {
  TOTAL_CLASSES // X clases totales durante el reto
  CONSECUTIVE_CLASSES // X clases seguidas (sin faltar)
  CLASSES_IN_DAYS // X clases en Y días
}

model Challenge {
  id          String            @id @default(cuid())
  name        String // "Reto 30 clases"
  description String? // "Asiste a 30 clases en 60 días"
  reward      String? // "Camiseta La Cueva"
  ruleType    ChallengeRuleType
  ruleTarget  Int // X clases requeridas
  ruleDays    Int? // Y días (para CLASSES_IN_DAYS)
  sede        Sede? // null = ambas sedes
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  progress ChallengeProgress[]
}

model ChallengeProgress {
  id           String    @id @default(cuid())
  challengeId  String
  challenge    Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  currentCount Int       @default(0)
  completed    Boolean   @default(false)
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([challengeId, memberId])
  @@index([memberId])
}

// ─────────────────────────────────────────────────────────────
// Chatbot — conversaciones, mensajes y secuencias
// ─────────────────────────────────────────────────────────────

enum ConversationChannel {
  WHATSAPP
  INSTAGRAM
  MESSENGER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Conversation {
  id             String              @id @default(cuid())
  leadId         String              @unique
  lead           Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sede           Sede
  channel        ConversationChannel @default(WHATSAPP)
  externalId     String // wa user id (phone wa_id) / IG user id
  botPaused      Boolean             @default(false)
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  messages           Message[]
  scheduledFollowups ScheduledFollowup[]

  @@unique([channel, externalId])
  @@index([sede])
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  channel        ConversationChannel @default(WHATSAPP)
  externalId     String?             @unique // WA msg id — idempotency for inbound; null for outbound bot messages with no upstream id
  body           String
  mediaUrl       String?
  sentByUserId   String? // null when bot or customer
  llmGenerated   Boolean             @default(false)
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

enum FollowupKind {
  NO_REPLY_2H
  NO_REPLY_1D
  NO_REPLY_3D
  TRIAL_CONFIRM
  TRIAL_REMINDER_24H
  TRIAL_REMINDER_2H
  ADMIN_ATTENDANCE_PING
  NOSHOW_RECOVERY_1D
  NOSHOW_RECOVERY_3D
}

enum FollowupStatus {
  PENDING
  SENT
  CANCELED
  FAILED
}

model ScheduledFollowup {
  id             String         @id @default(cuid())
  conversationId String
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kind           FollowupKind
  fireAt         DateTime
  status         FollowupStatus @default(PENDING)
  payload        Json?
  sentAt         DateTime?
  errorMessage   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, fireAt])
  @@index([conversationId, kind])
}

model BotConfig {
  id            String   @id @default(cuid())
  sede          Sede     @unique
  systemPrompt  String   @db.Text
  businessHours Json? // { "mon": ["06:00", "22:00"], ... }
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MessageTemplate {
  id               String              @id @default(cuid())
  name             String              @unique // internal key, e.g. "trial_reminder_24h"
  channel          ConversationChannel @default(WHATSAPP)
  metaTemplateName String // name registered in Meta Business Manager
  language         String              @default("es")
  body             String              @db.Text // human-readable preview, with {{var}} placeholders
  variables        Json? // ["leadName", "sede", "datetime"]
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model SrxfitSessionOverride {
  id                  String   @id @default(cuid())
  weekNumber          Int
  dayIndex            Int // 1=Mon ... 6=Sat
  activacionMd        String?  @db.Text
  fuerzaMd            String?  @db.Text
  acondicionamientoMd String?  @db.Text
  regulacionMd        String?  @db.Text
  coachNotesMd        String?  @db.Text
  updatedById         String?
  updatedBy           User?    @relation("SrxfitSessionOverrideUpdatedBy", fields: [updatedById], references: [id])
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@unique([weekNumber, dayIndex])
}

// ─────────────────────────────────────────────────────────────
// Nutrición — planes y adherencia
// ─────────────────────────────────────────────────────────────

enum MealPlanSource {
  MANUAL // nutritionist authored / linked by hand (v1)
  AI_GENERATED // produced by Claude API (future)
  AI_ASSISTED // AI draft edited by nutritionist (future)
}

// A member's meal plan. v1 is pragmatic (calorie target + a link to the
// nutritionist's existing Google Doc). `content` is the forward-compat landing
// zone for structured days→meals→options→kcal — manual authoring and future AI
// generation write the SAME shape, so a native renderer is source-agnostic.
model MealPlan {
  id              String            @id @default(cuid())
  memberId        String
  member          Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title           String
  calorieTarget   Int? // kcal/day — mirrors her calorie-level classification
  externalUrl     String? // Google Sheet/Doc — the immediate-term bridge
  content         Json? // structured plan; null in v1
  schemaVersion   Int               @default(1)
  source          MealPlanSource    @default(MANUAL)
  templateId      String?
  template        MealPlanTemplate? @relation(fields: [templateId], references: [id])
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean           @default(true) // soft-delete + "current plan"
  visibleToMember Boolean           @default(true) // portal shows only visible plans
  authoredById    String?
  authoredBy      User?             @relation("MealPlanAuthor", fields: [authoredById], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  logs MealLog[]

  @@index([memberId, active])
  @@index([memberId, createdAt])
}

// One row per member per day — the v1 adherence unit. `followed` is the daily
// "comí mi plan" check; `freeText` is what they actually ate. Upsert on the
// unique key so re-taps are idempotent.
model MealLog {
  id         String    @id @default(cuid())
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  mealPlanId String?
  mealPlan   MealPlan? @relation(fields: [mealPlanId], references: [id])
  date       DateTime  @db.Date // Ecuador local day
  followed   Boolean   @default(false)
  freeText   String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  entries MealLogEntry[] // empty in v1 — the per-meal extension point

  @@unique([memberId, date])
  @@index([memberId, date])
}

// Per-meal granularity. Table ships in v1 but is UNUSED until the structured
// `content` renderer exists — so per-food-option checks need no later migration.
model MealLogEntry {
  id          String   @id @default(cuid())
  mealLogId   String
  mealLog     MealLog  @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  mealKey     String // "breakfast" | "lunch" | ... matches content JSON
  optionLabel String?
  ate         Boolean  @default(false)
  freeText    String?  @db.Text
  kcal        Int? // snapshot of chosen option's kcal, for adherence math
  createdAt   DateTime @default(now())

  @@index([mealLogId])
}

// Reusable standard plans keyed by calorie level — the digital form of her
// calorie-classified Google Sheets, and the source-of-truth for future AI
// generation. No authoring UI in v1; seed manually or skip.
model MealPlanTemplate {
  id            String   @id @default(cuid())
  name          String // "Estándar 1400 kcal"
  calorieLevel  Int
  sede          Sede? // null = both
  content       Json?
  schemaVersion Int      @default(1)
  notes         String?  @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plans MealPlan[]

  @@index([calorieLevel, active])
}
